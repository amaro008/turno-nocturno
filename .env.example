# ============================================================================
# TURNO NOCTURNO — Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repo. En Vercel se cargan en Project Settings.
# ============================================================================

# ---------------------------------------------------------------------------
# SUPABASE  (Project Settings → API)
# ---------------------------------------------------------------------------
# URL del proyecto, ej: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (segura para el navegador). Empieza con "eyJ..." o "sb_publishable_..."
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (SOLO servidor — bypassa RLS). NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# ANTHROPIC  (el Comandante en vivo)  → https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo del Comandante. Recomendado para el piloto:
ANTHROPIC_MODEL=claude-sonnet-4-5
# Modelo para evaluar el veredicto (aislado, con rúbrica):
ANTHROPIC_EVAL_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# ELEVENLABS  (notas de voz generadas — OPCIONAL en MVP)
# Si se deja vacío, el Comandante responde solo en texto.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# RESEND  (email transaccional de códigos — OPCIONAL en MVP)
# Si se deja vacío, el admin ve el código en pantalla para enviarlo a mano.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Turno Nocturno <no-reply@turnonocturno.app>"

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# URL pública del sitio (para links en emails y redirects de auth).
# Local: http://localhost:3000  ·  Prod: https://turnonocturno.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
